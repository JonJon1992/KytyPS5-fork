  "findings": [
    {
      "source": "src/graphics/shader/recompiler/frontend/translate/Memory.cpp:818",
      "finding": "FLAT_LOAD splits DWORDX2/X3/X4 into scalar LoadAddressU32 and overwrites data_dwords with 1. All 28 wide loads in this guest listing have segment=2 (global), so optimize this explicit-global path first; the more complex FLAT_APERTURE is not needed for these wide loads."
    },
    {
      "source": "src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp:222",
      "finding": "Each LoadBda emits an active guard, aligned first dword, possible second dword, byte shifts and merge. Each LoadBdaDword calls translation and emits its own present guard."
    },
    {
      "source": "src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp:1090",
      "finding": "Translation is already a shared SPIR-V function. Its body is not duplicated in source SPIR-V for every call; driver inlining must be inspected separately. It checks the 40-bit aperture, indexes a 16-KiB page table and atomically records missing-page faults."
    },
    {
      "source": "src/graphics/shader/recompiler/backend/spirv/spirvEmitterInternal.h:642",
      "finding": "A nonconstant EmitValueOrDefaultIfCondition adds two labels, one conditional branch, one merge and one Phi. Scalarizing guard ownership multiplies this cost."
    },
    {
      "source": "src/graphics/shader/recompiler/ir/passes/ConstantPropagation.cpp:669",
      "finding": "Inverse U32/F32 bitcast folding already exists. A new cache should target repeated typed views of identical SSA values; do not duplicate existing inverse folding."
    }
  ],
  "second_changes": [
    "Typed SSA bitcast cache implemented and scoped to emitted labels.",
    "Cross-operation pure address/BDA reuse deferred pending register pressure, dominance and fault-side-effect evidence."
  ],
