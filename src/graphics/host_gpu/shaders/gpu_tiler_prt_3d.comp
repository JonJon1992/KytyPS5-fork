#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 65536u;
#include "gpu_tiler_standard64_3d.inc"
uvec3 block_extent() { return standard64_3d_extent(); }
uint block_offset(uvec3 p) {
	// One scalar selector per component: AMD's Windows compiler gets a vector Select on a
	// specialization constant wrong (Jetsku 7d881089). Same table as before, by ELEMENT_BYTES.
	uint sx = ELEMENT_BYTES == 1 ? 4u : ELEMENT_BYTES == 2 ? 4u : ELEMENT_BYTES == 4 ? 4u :
	          ELEMENT_BYTES == 8 ? 3u : 3u;
	uint sy = ELEMENT_BYTES == 1 ? 5u : ELEMENT_BYTES == 2 ? 4u : ELEMENT_BYTES == 4 ? 4u :
	          ELEMENT_BYTES == 8 ? 4u : 3u;
	uint sz = ELEMENT_BYTES == 1 ? 4u : ELEMENT_BYTES == 2 ? 3u : ELEMENT_BYTES == 4 ? 3u :
	          ELEMENT_BYTES == 8 ? 3u : 2u;
	uint sw = ELEMENT_BYTES == 1 ? 4u : ELEMENT_BYTES == 2 ? 4u : ELEMENT_BYTES == 4 ? 3u :
	          ELEMENT_BYTES == 8 ? 3u : 3u;
	uint delta = (((p.y >> sx) & 1u) << 10) ^ (((p.x >> sy) & 1u) << 10) ^
	             (((p.x >> sz) & 1u) << 11) ^ (((p.z >> sw) & 1u) << 11);
	return standard64_3d_offset(p) ^ delta;
}
#include "gpu_tiler_common.inc"
