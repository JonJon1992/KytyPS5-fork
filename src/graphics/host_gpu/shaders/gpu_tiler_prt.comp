#version 450
#extension GL_GOOGLE_include_directive : require
layout(constant_id = 0) const uint ELEMENT_BYTES = 4u;
layout(constant_id = 1) const uint TILE = 0u;
const uint BLOCK_BYTES = 65536u;
#include "gpu_tiler_standard64.inc"
uvec3 block_extent() {
	uint width = ELEMENT_BYTES <= 2 ? 256u : (ELEMENT_BYTES <= 8 ? 128u : 64u);
	return uvec3(width, BLOCK_BYTES / (width * ELEMENT_BYTES), 1u);
}
uint block_offset(uvec3 p) {
	// One scalar selector per component: AMD's Windows compiler gets a vector Select on a
	// specialization constant wrong (Jetsku 7d881089). Same table as before, by ELEMENT_BYTES.
	uint sx = ELEMENT_BYTES == 1 ? 7u : ELEMENT_BYTES == 2 ? 7u : ELEMENT_BYTES == 4 ? 6u :
	          ELEMENT_BYTES == 8 ? 6u : 5u;
	uint sy = ELEMENT_BYTES == 1 ? 7u : ELEMENT_BYTES == 2 ? 6u : ELEMENT_BYTES == 4 ? 6u :
	          ELEMENT_BYTES == 8 ? 5u : 5u;
	uint sz = ELEMENT_BYTES == 1 ? 6u : ELEMENT_BYTES == 2 ? 6u : ELEMENT_BYTES == 4 ? 5u :
	          ELEMENT_BYTES == 8 ? 5u : 4u;
	uint sw = ELEMENT_BYTES == 1 ? 6u : ELEMENT_BYTES == 2 ? 5u : ELEMENT_BYTES == 4 ? 5u :
	          ELEMENT_BYTES == 8 ? 4u : 4u;
	uint delta = (((p.x >> sx) & 1u) << 8) ^ (((p.y >> sy) & 1u) << 9) ^
	             (((p.x >> sz) & 1u) << 10) ^ (((p.y >> sw) & 1u) << 11);
	return standard64_offset(p.xy) ^ delta;
}
#include "gpu_tiler_common.inc"
